# Optional: a Slack Incoming Webhook URL for the channel you want orders posted to.
# Create one at https://api.slack.com/apps -> your app -> Incoming Webhooks -> Add New Webhook to Workspace
# If you leave this unset, the app still works — it just skips the Slack post.
SLACK_WEBHOOK_URL=

# These are added automatically when you attach a Vercel KV store to the project.
# You don't need to set them by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
